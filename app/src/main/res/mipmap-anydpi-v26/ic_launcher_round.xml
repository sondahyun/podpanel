<?xml version="1.0" encoding="utf-8"?>
<!--
    Two layers the launcher masks into its own shape — circle, squircle, teardrop —
    instead of padding a flat drawable into a white blob. The monochrome layer is what
    Android 13+ themed icons tint to the wallpaper's palette.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
